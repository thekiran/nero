[2.781, "o", "\r\nEXPERIMENTAL SOFTWARE \u2014 LABORATORY USE ONLY\r\nEXPERIMENTAL SOFTWARE \u2014 RESTRICTED TO LABORATORY USE\r\nIsolated or explicitly authorized testing only. Not for public or production use.\r\nUse isolated or authorized test environments; public and production use is not permitted.\r\n\r\n"]
[2.782, "o", "\u001b[1;32mAvailable Commands:\u001b[0m\r\n\u001b[1;34m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n1.\u001b[1;33m<network IP> -Syn   \u001b[0m : Run SYN/UDP packet flood (authorized targets)\r\n2.\u001b[1;33m-Syn <network IP>   \u001b[0m : Alias for the SYN/UDP packet flood\r\n3.\u001b[1;33mhelp                \u001b[0m : Show this help message\r\n4.\u001b[1;33mhelp -All           \u001b[0m : Show this help message\r\n5.\u001b[1;33mexit                \u001b[0m : Quit the shell\r\n6.\u001b[1;33mclear               \u001b[0m : Clear the screen\r\n7.\u001b[1;33mhistory             \u001b[0m : Show command history\r\n8.\u001b[1;33mversion             \u001b[0m : Show program version\r\n9.\u001b[1;33mhistory -clear      \u001b[0m : Clear command history\r\n10.\u001b[1;33mexit -All           \u001b[0m : Quit the shell and clear the screen\r\n11.\u001b[1;33m<target> -Sc        \u001b[0m : Check TCP ports (offline builds simulate)\r\n12.\u001b[1;33m-mode               \u001b[0m : Show network diagnostics setting\r\n13.\u001b[1;33m<targ"]
